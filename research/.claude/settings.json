{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-opus-4-8[1m]",
  "effortLevel": "max",
  "statusLine": {
    "type": "command",
    "command": "printf '%s · %s · runs=%s · burn=$%s/hr' \"$(jq -r '.model.display_name // \"claude\"' 2>/dev/null)\" \"$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo no-branch)\" \"$(jq -s 'map(select(.status==\"RUNNING\")) | length' .claude/state/runs.jsonl 2>/dev/null || echo 0)\" \"$(jq -s 'map(select(.status==\"RUNNING\")) | map(.dph // 0) | add // 0' .claude/state/runs.jsonl 2>/dev/null || echo 0)\""
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/kill-switch.sh" },
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/protect-upstream.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/sync-metrics.sh" }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/commit-on-stop.sh" },
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/teardown-finished-runs.sh" }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/on-session-start.sh" }
        ]
      }
    ]
  }
}
