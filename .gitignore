# research harness — large run artifacts (untracked; SUMMARY.md is the durable record)
research/runs/**/*.bundle
research/runs/**/*.log
research/runs/**/exp.bundle
# experiment-runner subagent worktrees (transient; auto-cleaned via `git worktree remove`)
.claude/worktrees/

# large re-downloadable paper PDFs — keep the distilled notes, not the binary
research/refs/*.pdf

# EXP fp32 tensor captures (tens of GB; rsynced from boxes, never re-downloadable but
# too large for git — preserved on disk + summarized in audit JSONs/reports)
research/runs/*/captures/
research/runs/*/metrics/onbox/
research/runs/*/metrics/incoming.log
# Dataset-keyed subdir layout (e.g. runs/<ID>/<dataset>/captures/) — same ignore, one level deeper
research/runs/*/*/captures/
research/runs/*/*/metrics/onbox/
research/runs/*/*/metrics/incoming.log

# Weight-trajectory heavy .pt staging (large local-only data; R2 is the durable store,
# the .jsonl manifests + analysis outputs are committed)
research/runs/*/weights/**/*.pt
research/runs/*/*/weights/**/*.pt

# ── harness-v1 (autonomous-harness-v1) ───────────────────────────────────────
# machine state — ONE live copy shared by all worktrees; never versioned
research/.claude/state/runs.jsonl
research/.claude/state/.last-*
research/.claude/state/.runs.jsonl.lock/
research/.claude/state/vast-handles/
# derived cache of the GitHub-resident plans (SSOT = the issue body)
research/.claude/state/plan-cache/
# the /build phase skill — upstream's `build/` python ignore above would swallow it
!research/.claude/skills/build/
# bulk analysis caches — regenerable; folded by the human-only de-bloat skill
research/runs/**/*.npz
research/runs/**/panel_cache*
research/runs/**/scorecard.jsonl
